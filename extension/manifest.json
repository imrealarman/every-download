{
  "manifest_version": 3,
  "name": "EveryDownload",
  "version": "1.0.2",
  "description": "Sends downloads to EveryDownload, adds a Download button to videos, and finds files on any page.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "webRequest", "contextMenus", "storage", "cookies", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "EveryDownload",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
